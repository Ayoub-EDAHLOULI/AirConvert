# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# FFmpeg sidecar binary — too large for git, and licensing (LGPL build)
# means it should be fetched/verified per-machine rather than committed.
# See README for where to get it and what filename Tauri expects.
/binaries/*
!/binaries/.gitkeep
