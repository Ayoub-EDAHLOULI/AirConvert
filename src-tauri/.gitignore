# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Sidecar binaries (FFmpeg, Pandoc) — too large for git, and FFmpeg's
# licensing (GPL vs LGPL builds) means it should be fetched/verified
# per-machine rather than committed. See README for where to get each one
# and what filename Tauri expects.
/binaries/*
!/binaries/.gitkeep
